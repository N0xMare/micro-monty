@@ -43,12 +43,32 @@ impl StdModule {
     /// Decode within a workspace budget including unpacking, the string pool
     /// and the owned Program that stays alive while its codes are loaded.
     pub(crate) fn decode(&self, budget: &mut u64) -> Result<Program, mm_compile::DecodeError> {
+        // PROTOTYPE (local branch, not for main): decoded bundled modules
+        // are cached once per process and shared by every session, as the
+        // prelude's code is. The workspace budget is not charged on a hit.
+        type Entry = (usize, Vec<Arc<mm_compile::bytecode::Code>>, u32, bool);
+        static CACHE: std::sync::Mutex<Vec<Entry>> = std::sync::Mutex::new(Vec::new());
+        let key = self.code.as_ptr() as usize;
+        if let Ok(cache) = CACHE.lock()
+            && let Some(e) = cache.iter().find(|e| e.0 == key)
+        {
+            return Ok(Program {
+                codes: e.1.clone(),
+                entry: e.2,
+                returns_last_expr: e.3,
+                warnings: Vec::new(),
+            });
+        }
         let bytes = if self.header.is_empty() {
             mm_compile::pack::unpack_bounded(self.code, budget)?
         } else {
             mm_compile::pack::unpack_shared_bounded(self.header, self.code, budget)?
         };
-        Program::decode_bounded(&bytes, budget)
+        let p = Program::decode_bounded(&bytes, budget)?;
+        if let Ok(mut cache) = CACHE.lock() {
+            cache.push((key, p.codes.clone(), p.entry, p.returns_last_expr));
+        }
+        Ok(p)
     }
 }
 
