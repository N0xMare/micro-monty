+    /// The session's image relative to the base, in the output.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn mm_snapshot_relative(s: u32) -> u32 {
+        with_slot(s, |slot| match slot.session.snapshot() {
+            Ok(image) => match super::with_base(|b| super::delta::encode(&image, b, 256)) {
+                Some(Ok(d)) => {
