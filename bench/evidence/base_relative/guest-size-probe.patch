 use std::cell::RefCell;
 
+#[allow(dead_code, reason = "size probe")]
+mod delta;
+
+thread_local! {
+    static BASE: RefCell<Option<delta::Base>> = const { RefCell::new(None) };
+}
+
+/// Runs `f` with the base: this build's fresh-session image, made once.
+fn with_base<T>(f: impl FnOnce(&delta::Base) -> T) -> Option<T> {
+    BASE.with_borrow_mut(|b| {
+        if b.is_none() {
+            let engine = Engine::new(EngineConfig::default());
+            let image = Session::new(&engine).ok()?.snapshot().ok()?;
+            *b = delta::Base::new(&image).ok();
+        }
+        b.as_ref().map(f)
+    })
+}
