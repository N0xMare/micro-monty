+    /// A session restored from the input: options, then a relative image.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn mm_session_restore_relative() -> i32 {
+        let restored = input(|i| {
+            let mut r = Reader::new(i);
+            let o = get_options(&mut r)?;
+            let engine = engine(&o);
+            let full = super::with_base(|b| super::delta::apply(r.rest(), b, true));
+            Ok::<_, mm_wasm_abi::Bad>((o, engine, full))
+        });
+        match restored {
+            Ok((o, engine, Some(Ok(full)))) => match engine.restore(&full) {
+                Ok(mut session) => {
+                    install(next_id(), &mut session, &o);
+                    push(Slot { engine, session, deadline: None }).cast_signed()
+                }
+                Err(e) => {
+                    output(|out| put_snapshot_error(out, &e));
+                    -1
+                }
+            },
+            _ => {
+                bad("restore relative");
+                -2
+            }
+        }
+    }
