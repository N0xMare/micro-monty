{
  "classification": "[M] measured; orb timings, not a cross-engine performance claim",
  "baseline_commit": "15a2c35042dd5b47098df962529f2a17e83cf84c",
  "candidate": "Native rendering ownership phase containing this record",
  "rustc": "rustc 1.99.0 (b940084d7 2026-09-28)",
  "recipe": {
    "build": "cargo build --release --locked -p micro-monty --message-format=json; select the micro_monty .rlib compiler artifact",
    "compile": "rustc --edition=2024 -O -C panic=abort DRIVER -L dependency=BUILD/target/release/deps --extern micro_monty=RLIB -o DRIVER_BINARY",
    "timing": "taskset -c 2 DRIVER_BINARY; three alternating process pairs: before/after, after/before, before/after; five warmups then 31 samples per fixture/process; setup and compilation excluded, Session::start and assertions included",
    "budget": "DRIVER_BINARY and DRIVER_BINARY stress; 40 operation/budget pairs in each mode; same-budget snapshot/restore and recovery; non-stressed run also checks completion fallback",
    "semantics": "python3.14 DRIVER.py versus mm run DRIVER.py and MM_GC_STRESS=1 mm run DRIVER.py"
  },
  "limitations": [
    "Scalar timings changed direction between trials; no universal speedup or stable scalar improvement established.",
    "No RSS or hard park-latency bound.",
    "Admission intentionally rejects some formerly successful low-budget operations."
  ],
  "drivers": {
    "render-timing.rs": "use micro_monty::{Engine, Progress, Session};\nuse std::time::Instant;\n\nfn main() {\n    for (name, setup, source) in [\n        (\"scalar\", \"\", \"for i in range(1000):\\n    text = repr(i)\\nassert text == '999'\\ntext = None\"),\n        (\"wide\", \"data = list(range(5000))\", \"text = repr(data)\\nassert len(text) == 28890\\ntext = None\"),\n        (\"repr\", \"data = '€\\\\n' * 65536\", \"text = repr(data)\\nassert len(text) == 196610\\ntext = None\"),\n        (\"ascii\", \"data = '€\\\\n' * 65536\", \"text = ascii(data)\\nassert len(text) == 524290\\ntext = None\"),\n        (\"exception\", \"data = '€\\\\n' * 65536\", \"text = str(OSError(7, data, data, None, data))\\nassert len(text) == 524308\\ntext = None\"),\n        (\"padding\", \"data = '€\\\\n' * 65536\", \"text = format(data, '🐍^300000.20')\\nassert len(text) == 300000\\ntext = None\"),\n        (\"small-padding\", \"\", \"for i in range(1000):\\n    text = format(i, '+010d')\\nassert text == '+000000999'\\ntext = None\"),\n    ] {\n        let engine = Engine::new(Default::default());\n        let mut session = Session::new(&engine).expect(\"session\");\n        let setup = engine.compile(setup, \"setup.py\").expect(\"setup\");\n        assert_eq!(session.start(&setup), Progress::Complete(None));\n        let code = engine.compile(source, \"render.py\").expect(\"code\");\n        for _ in 0..5 {\n            assert_eq!(session.start(&code), Progress::Complete(None));\n        }\n        let mut samples = Vec::new();\n        for _ in 0..31 {\n            let start = Instant::now();\n            let result = session.start(&code);\n            let ns = start.elapsed().as_nanos();\n            assert_eq!(result, Progress::Complete(None));\n            samples.push(ns);\n        }\n        println!(\"{name} {samples:?}\");\n    }\n}\n",
    "render-probe.rs": "use micro_monty::{Engine, EngineConfig, HostArgs, Limits, Progress, Resume, Session};\n\nfn main() {\n    let stress = std::env::args().any(|arg| arg == \"stress\");\n    for memory in [3, 4, 6, 8] {\n        for operation in [\n            \"repr(data)\",\n            \"repr([data] * 4)\",\n            \"ascii(data * 2)\",\n            \"str(ValueError(data))\",\n            \"str(OSError(7, data, data, None, data))\",\n            \"'%r' % ([data] * 4)\",\n            \"'{!r}'.format([data] * 4)\",\n            \"format(data, '🐍^300000.20')\",\n            \"format(-173, '🐍=+300000d')\",\n            \"format(7.125, '🐍^300000.2f')\",\n        ] {\n            let engine = Engine::new(EngineConfig {\n                limits: Limits { memory: memory << 20, ..Limits::default() },\n            });\n            let mut session = Session::new(&engine).expect(\"session\");\n            session.set_gc_stress(stress);\n            let setup = engine.compile(\"data = '€\\\\n' * 65536\", \"setup.py\").expect(\"setup\");\n            assert_eq!(session.start(&setup), Progress::Complete(None));\n            let source = format!(\n                \"try:\\n    text = {operation}\\n    result = len(text)\\nexcept MemoryError:\\n    result = -1\\nassert repr([7, 3]) == '[7, 3]'\\nresult\"\n            );\n            let code = engine.compile(&source, \"render.py\").expect(\"code\");\n            let result = match session.start(&code) {\n                Progress::Complete(Some(c)) => c.repr,\n                other => format!(\"{other:?}\"),\n            };\n            let image = session.snapshot().expect(\"snapshot\");\n            drop(session);\n            let mut session = engine.restore(&image).expect(\"restore\");\n            session.set_gc_stress(stress);\n            let recovery = engine.compile(\n                \"data = None\\ntext = None\\nassert repr({'a': [8, 4]}) == \\\"{'a': [8, 4]}\\\"\",\n                \"recovery.py\",\n            ).expect(\"recovery\");\n            assert_eq!(session.start(&recovery), Progress::Complete(None));\n            println!(\"{memory} MiB | {operation} | {result} | restored and recovered\");\n        }\n    }\n    if stress {\n        return;\n    }\n    for memory in [3 << 20, (3 << 20) + (256 << 10)] {\n        let engine = Engine::new(EngineConfig {\n            limits: Limits { memory, ..Limits::default() },\n        });\n        let mut session = Session::new(&engine).expect(\"session\");\n        session.set_gc_stress(stress);\n        session.set_text_limit(16);\n        session.set_host_args(HostArgs { max_bytes: 0, ..HostArgs::default() });\n        let setup = engine.compile(\"data = [] + [[i] for i in range(20000)]\", \"setup.py\").expect(\"setup\");\n        assert_eq!(session.start(&setup), Progress::Complete(None));\n        session.set_fuel(Some(100));\n        let code = engine.compile(\"data\", \"render.py\").expect(\"code\");\n        let mut p = session.start(&code);\n        println!(\"completion {memory} bytes | initial {p:?}\");\n        while matches!(p, Progress::Parked { .. }) {\n            session.set_fuel(Some(1_000_000));\n            p = session.resume(Resume::Continue).expect(\"resume\");\n        }\n        println!(\"completion {memory} bytes | final {p:?}\");\n    }\n}\n",
    "render-semantics.py": "for fill in [' ', 'é', '🐍']:\n    for align in ['<', '>', '^', '=']:\n        for width in [0, 3, 8, 9]:\n            prefix = fill + align\n            for value in [-173, 17]:\n                print(repr(format(value, prefix + '+#' + str(width) + 'x')))\n            print(repr(format(-7.125, prefix + '+' + str(width) + '.2f')))\n            if align != '=':\n                print(repr(format('€x🐍', prefix + str(width) + '.2s')))\n                print(repr(format(1-2j, prefix + str(width) + '.2f')))\nfor text in ['', 'plain', 'é€𐐷', \"both'\\\"quotes\", '\\n\\t\\r\\\\']:\n    print(repr(text))\n    print(ascii(text))\n    print('%r | %.3s | %a' % (text, text, text))\n    print('{!r} | {!s}'.format(text, text))\nprint(repr(b\"\\x00\\xff'\\\"\\n\"))\nvalue = [1, 3]\nvalue.append(value)\nprint(repr(value))\nprint(str(OSError(7, 'm\\né', 'one', None, '🐍two')))\nprint(OSError(7, 'm\\né', 'one', None, '🐍two').__str__())\nprint(ValueError('é', [7, 3]).__repr__())\n"
  },
