{
	"name": "mm-wasm-host",
	"version": "0.0.0",
	"private": true,
	"description": "A JavaScript host for the micro-monty mm-wasm guest (Node, workerd / Cloudflare Workers), and its measurements",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": "./src/host.ts",
		"./driver": "./src/driver.ts"
	},
	"engines": {
		"node": ">=23.6"
	},
	"scripts": {
		"guests": "python3.14 -I scripts/build-guests.py",
		"test": "node --test --expose-gc test/*.test.ts",
		"typecheck": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"quickjs-wasi": "3.6.2",
		"typescript": "7.0.2",
		"wrangler": "4.158.0"
	}
}
